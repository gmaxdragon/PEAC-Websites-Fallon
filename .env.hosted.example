PEAC_DEPLOY_MODE=hosted
PEAC_DB_PATH=/data/peac.sqlite3
PEAC_ADMIN_USERNAME=change-me
PEAC_ADMIN_DISPLAY_NAME=PEAC Admin
PEAC_ADMIN_PASSWORD=use-a-unique-12-plus-character-password
